# المثبّت (install_windows.bat) بيعمل الملف ده لوحده. التعديل اليدوي اختياري.

# التوكن من @BotFather (سر — متبعتهوش لحد)
TELEGRAM_BOT_TOKEN=123456789:AA-your-token-here

# البوت خاص: أول /start بيبقى المالك، والباقي مرفوضين إلا اللي تسمحلهم بـ /allow
PRIVATE_MODE=true

# اختياري: أرقام تليجرام لأدمن إضافيين أو مستخدمين مسموح لهم (بفاصلة)
# ADMIN_IDS=123456789
# ALLOWED_IDS=

# اسم البوت في رسالة الترحيب
BOT_NAME=بوت الجمارك

# استعلام لحظي من موقع مصلحة الجمارك لكل بند
LIVE_LOOKUP=true
LIVE_CACHE_HOURS=24

# تحديث التعريفة كلها تلقائياً كل كام يوم (0 = متوقف)
AUTO_UPDATE_DAYS=7

# مكان ملفات البيانات (اختياري)
# DATA_DIR=C:\CustomsBotData
